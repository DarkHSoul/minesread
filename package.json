{
  "name": "minesread",
  "version": "4.39.0",
  "description": "Mineflayer fork providing Minecraft client state, events and action APIs",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "mocha_test": "mocha --reporter ./test/common/durationsReporter.js --exit",
    "test": "npm run mocha_test",
    "pretest": "npm run lint",
    "lint": "standard && standard-markdown",
    "fix": "standard --fix && standard-markdown --fix",
    "prepublishOnly": "cp docs/README.md README.md",
    "minesread:setup-data": "node minesread/scripts/setup-data.js",
    "minesread:check": "node minesread/scripts/check-versions.js",
    "minesread:server-setup": "node minesread/scripts/server-setup.js",
    "minesread:server": "node minesread/scripts/run-server.js",
    "minesread:smoke": "node minesread/scripts/smoke.js",
    "minesread:smoke-actions": "node minesread/scripts/smoke-actions.js",
    "minesread:probe": "node minesread/scripts/probe.js",
    "test:api": "mocha --require ./index.js test/biomeCooldownTest.js test/biomeProtocolTest.js test/cooldownProtocolTest.js test/visionDamageTest.js test/combatApiTest.js test/explosionApiTest.js test/entityObservationTest.js test/dragonPartsTest.js test/serverRecipesTest.js test/advancementsTest.js test/multipartTargetTest.js test/attributeProtocolTest.js test/biomePersistenceTest.js test/uiInventoryTest.js test/uiCraftTest.js test/uiTradeTest.js test/protocolCompatTest.js test/chunkCompatTest.js test/itemComponentsCompatTest.js test/lifecycleCompatTest.js --reporter dot",
    "test:26.3": "mocha test/internalTest.js --grep \"mineflayer_internal 26.3v\" --reporter dot --exit",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "build": "node minesread/scripts/build.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/PrismarineJS/mineflayer.git"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "minecraft-data": "3.119.0",
    "minecraft-protocol": "github:DarkHSoul/node-minecraft-protocol#3473413d32ee09af55aa77579000391be3bb9753",
    "mojangson": "^2.0.4",
    "prismarine-biome": "^1.1.1",
    "prismarine-block": "^1.22.0",
    "prismarine-chat": "^1.7.1",
    "prismarine-chunk": "github:DarkHSoul/prismarine-chunk#a96fd7050163b5ae3cbce240deab453a03cd3bc2",
    "prismarine-entity": "^2.5.0",
    "prismarine-item": "^1.17.0",
    "prismarine-nbt": "^2.0.0",
    "prismarine-physics": "github:DarkHSoul/prismarine-physics#02242786224f862ebcc5d6e529e60bd026c36a54",
    "prismarine-recipe": "^1.5.0",
    "prismarine-registry": "^1.10.0",
    "prismarine-windows": "^2.9.0",
    "prismarine-world": "^3.6.0",
    "protodef": "^1.18.0",
    "smart-buffer": "^4.2.0",
    "typed-emitter": "^1.0.0",
    "uuid-1345": "^1.0.2",
    "vec3": "^0.1.7"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "doctoc": "^2.0.1",
    "minecraft-wrap": "^1.3.0",
    "mineflayer": "./",
    "mocha": "^11.0.1",
    "protodef-yaml": "^1.5.3",
    "standard": "^17.0.0",
    "standard-markdown": "^7.1.0",
    "typescript": "^5.4.5",
    "mineflayer-pathfinder": "2.4.5"
  },
  "private": true,
  "overrides": {
    "minecraft-data": "$minecraft-data",
    "minecraft-protocol": "$minecraft-protocol",
    "prismarine-chunk": "$prismarine-chunk",
    "prismarine-physics": "$prismarine-physics"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/",
    "minesread/scripts/",
    "minesread/docs/",
    "docs/",
    "LICENSE",
    "README.md"
  ]
}
